{%- macro step(params) -%}
<li class="ds_step-navigation__item
        {% if params.isCurrent %}ds_current{% endif %}
        {% if params.type == 'and' %}ds_step-navigation__and{% endif %}
        {% if params.type == 'or' %}ds_step-navigation__or{% endif %}"
    value="{{params.value}}"
    {% if params.isCurrent %}aria-current="step"{% endif %}
>
    <span class="ds_step-navigation__count">
        {%- if params.type == 'and' %}
            and <span class="visually-hidden">this step</span>
        {%- elif params.type == 'or' %}
            or <span class="visually-hidden">this step</span>
        {%- else %}
            <span class="visually-hidden">Step </span>{{ params.value }}
        {%- endif %}
    </span>
    <details {% if params.isOpen %}open{% endif %} value="{{params.value}}" class="ds_accordion-item {%- if params.parentIsSmall %}  ds_accordion-item--small{%- endif %}  {% if params.isOpen %}ds_accordion-item--open{% endif %}">
        <summary class="ds_accordion-item__header">
            {{params.heading}}
            <span aria-hidden="true" class="ds_accordion-item__indicator"></span>
        </summary>

        <div class="ds_accordion-item__body" id="accordion-item-{{params.index}}">
            {{params.content | safe}}
        </div>
    </details>
</li>
{%- endmacro -%}

{{step({
    content: content,
    heading: heading,
    isCurrent: isCurrent,
    isOpen: isOpen,
    type: type,
    value: value,
    parentIsSmall: parentIsSmall,
    index: index
})}}
